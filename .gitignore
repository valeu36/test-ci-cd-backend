# compiled output
/dist
/node_modules
# Incremental build state. tsconfig.build.json pins its own inside dist/ (it
# must die with `deleteOutDir`), but tsc --noEmit writes one from the root
# config too — and a stray one at the repo root is exactly what makes a build
# skip emitting files whose output was just wiped.
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*

# OS
.DS_Store

# Tests
/coverage

# IDEs and editors
/.idea
.vscode/*
!.vscode/extensions.json

# dotenv environment variable files — the *.example file is committed, real
# values are not. .env.testing is generated by scripts/ensure-env-testing.sh.
.env*
!.env.example
