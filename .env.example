# Copy to .env.development for `npm run start:dev`. Every value can also come
# from the real environment, which wins over the file (that is how Railway
# configures a deployment).
NODE_ENV=development
PORT=3000
# Matches docker-compose.dev.yml (`npm run docker:dev:up`). On Railway:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Comma-separated SPA origins allowed to call the API cross-origin.
# Empty in dev: the vite dev server proxies /api, so the SPA is same-origin.
CORS_ORIGINS=
SWAGGER_ENABLED=true
# Express trust proxy. Empty = trust none (local). Railway: 1 (set in .railway/railway.ts).
TRUST_PROXY=
